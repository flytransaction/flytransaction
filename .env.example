# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase (https://supabase.com/dashboard -> Project Settings -> API Keys) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...). Legacy projects may use the anon JWT instead via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# SERVER ONLY. Secret key (sb_secret_...) or legacy service_role JWT. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# ---------- Stripe (https://dashboard.stripe.com/apikeys) ----------
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
# Optional: only used by scripts/seed-dev-users.ts and README examples. Real price IDs live in the `plans` table
# (set from /admin/plans), not in env, so the Super Admin can change them.

# ---------- Scheduled jobs ----------
# Random 32+ char string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

# ---------- Email ----------
# Auth emails (verify / reset) are sent by Supabase Auth. For production configure custom SMTP in
# Supabase Dashboard -> Authentication -> SMTP Settings (Resend, Postmark, SES, ...). No app-level email provider is required.

# ---------- Tests (use a SEPARATE test project, never production) ----------
# TEST_SUPABASE_URL=http://127.0.0.1:54321
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_SUPABASE_SECRET_KEY=
